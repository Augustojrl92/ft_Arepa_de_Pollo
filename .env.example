# ─────────────────────────────────────────────────────────────────────────────
# Single environment file for the whole stack. Copy to .env and fill in.
#
#   cp .env.example .env
#
# Docker Compose reads .env automatically for ${VAR} substitution *and* injects
# it into the backend container, which also bind-mounts it to /app/.env so the
# cron jobs get the same environment.
# ─────────────────────────────────────────────────────────────────────────────

# ── Compose / frontend ───────────────────────────────────────────────────────
# Address the BROWSER uses to reach the backend. It is compiled into the client
# bundle, so it must be reachable from wherever the app is opened.
#
#   Local only:  http://localhost:8000
#   LAN testing: http://<server-lan-ip>:8000
#
# When using a LAN address, open the frontend on the SAME host
# (http://<server-lan-ip>:3000). Serving the page from localhost while the API
# is on another host makes the auth cookies cross-site, and SameSite=Lax
# refuses to store them. Keep this in step with FRONTEND_URL and
# FT_REDIRECT_URI below.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Backend (Django) ─────────────────────────────────────────────────────────
# 42 API Configuration
FT_CLIENT_ID=ft_user_id_here
FT_CLIENT_SECRET=ft_user_secret_here
FT_REDIRECT_URI=http://localhost:8000/api/auth/42/callback/
FT_API_BASE_URL=https://api.intra.42.fr
FRONTEND_URL=http://localhost:3000
JWT_COOKIE_SECURE=False
JWT_COOKIE_SAMESITE=Lax

# Allowed hosts for Django
ALLOWED_HOSTS="localhost,127.0.0.1,0.0.0.0"

# Email delivery (verification and password reset links)
# Development uses the console backend, which prints emails to the container logs.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp_host_here
EMAIL_PORT=587
EMAIL_HOST_USER=smtp_user_here
EMAIL_HOST_PASSWORD=smtp_password_here
EMAIL_USE_TLS=True
# Quoted: cron sources this file with `sh`, which would choke on the < >.
DEFAULT_FROM_EMAIL="AEDLPH <no-reply@aedlph.local>"

# Lifetime in seconds of emailed verification / password reset links
PASSWORD_RESET_TIMEOUT=86400

# Database configuration
DB_NAME=db_name_here
DB_USER=db_user_here
DB_PASSWORD=db_password_here
DB_HOST=db_host_here
DB_PORT=db_port_here
# Signing key for sessions and JWTs. Generate your own; never reuse the default.
#   python3 -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits+'!@%^&*(-_=+)') for _ in range(64)))"
SECRET_KEY=change_me

# LAN testing only — both MUST be tightened for production.
#CORS_ALLOW_ALL_ORIGINS=True
#CORS_EXTRA_ORIGINS=http://<server-lan-ip>:3000
