# ==============================================================================
# AEDLPH — environment configuration
# Copy this file to `.env` and fill in the real values. This single file is
# consumed by every service (frontend, backend, public_api, proxy, database)
# — there is no per-service .env anymore.
# ==============================================================================

# ── Frontend (Next.js) ───────────────────────────────────────────────────────
# Browser-visible backend URL. Empty = same origin. The proxy serves the app
# and the API from one host, so the browser calls /api/... relative to
# whatever address it loaded the page from. No per-machine edits needed.
NEXT_PUBLIC_API_URL=

# Enables the PWA service worker outside of a production build.
NEXT_PUBLIC_ENABLE_PWA=false

# ── Proxy (nginx / TLS) ───────────────────────────────────────────────────────
# Names the dev certificate is valid for. Leave this alone: `make certs-reset`
# detects the current hostname and LAN IP and overrides it, so a new DHCP
# lease never needs an edit here.
TLS_SAN=DNS:localhost,IP:127.0.0.1

# ── Database (shared by backend, public_api, db and db-backup) ──────────────
DB_NAME=trascendence
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# ── Public API (FastAPI) ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/1
PUBLIC_API_RATE_LIMIT_WINDOW_SECONDS=60

# ── Backend (Django) ─────────────────────────────────────────────────────────
SECRET_KEY=insecure-dev-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://localhost
CSRF_TRUSTED_ORIGINS=https://localhost
SECURE_SSL_REDIRECT=True

# Cookies holding the JWT. Only relax JWT_COOKIE_SECURE when serving over
# plain HTTP (e.g. a bare `python manage.py runserver` outside Docker).
JWT_COOKIE_SECURE=True
JWT_COOKIE_SAMESITE=Lax

# 42 OAuth (intra.42.fr application credentials).
# FT_REDIRECT_URI must be registered verbatim on the 42 application.
FT_CLIENT_ID=ft_user_id_here
FT_CLIENT_SECRET=ft_user_secret_here
FT_REDIRECT_URI=https://localhost/api/auth/42/callback/
FT_API_BASE_URL=https://api.intra.42.fr
FRONTEND_URL=https://localhost

# ── Database backups (db-backup service) ─────────────────────────────────────
BACKUP_INTERVAL_SECONDS=21600
BACKUP_RETRY_SECONDS=300
BACKUP_RETENTION_DAYS=7
