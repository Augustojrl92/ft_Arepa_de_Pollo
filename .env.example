# Browser-visible backend URL. Use the server LAN IP for multi-device testing.
# Empty = same origin. The proxy serves the app and the API from one
# host, so the browser calls /api/... relative to whatever address it
# loaded the page from. No per-machine edits needed.
NEXT_PUBLIC_API_URL=

CORS_ALLOWED_ORIGINS=https://localhost
CSRF_TRUSTED_ORIGINS=https://localhost

# Names the dev certificate is valid for. Leave this alone: `make certs-reset`
# detects the current hostname and LAN IP and overrides it, so a new DHCP
# lease never needs an edit here.
TLS_SAN=DNS:localhost,IP:127.0.0.1
